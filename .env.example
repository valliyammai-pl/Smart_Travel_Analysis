# SmartTravel Production & Local Environment Configuration
# Copy this file to backend/.env for local development

PORT=5000

# Neon PostgreSQL Connection Strings
# DATABASE_URL: Pooled connection string for runtime queries
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string for migrations
DIRECT_URL="postgresql://username:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# JWT Secret (Mandatory in production; generate via: openssl rand -base64 32)
JWT_SECRET="your_strong_random_jwt_secret_here"

# Node Environment ('production' on Render)
NODE_ENV="production"

# Optional: Custom client URL or extra allowed origins
CLIENT_URL=""
ALLOWED_ORIGINS=""

# Administrator Bootstrap (Idempotent seed)
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_ADMIN_PASSWORD="your_secure_admin_password_here"
