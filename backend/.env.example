# Server Port (Render dynamically assigns PORT in production)
PORT=5000

# Database Configuration (Neon PostgreSQL)
# DATABASE_URL: Pooled connection string (PgBouncer, typically port 6543) for runtime queries
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string (port 5432) for Prisma CLI migrations & schema push
DIRECT_URL="postgresql://username:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# JWT Secret (Must be a secure random string in production, e.g. `openssl rand -base64 32`)
JWT_SECRET="your_strong_random_jwt_secret_here"

# Application Environment
NODE_ENV="development"

# Client URL (Optional when frontend is served from the same origin on Render)
CLIENT_URL="http://localhost:5173"
ALLOWED_ORIGINS=""

# Initial Administrator (Used by idempotent database seed; never commit real passwords)
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_ADMIN_PASSWORD="your_secure_admin_password_here"
